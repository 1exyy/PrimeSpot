{
  "name": "primespot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "маркетплейс для бронирования элитных коворкинг-пространств, переговорных комнат и креативных офисов. Проект имитирует коммерческий продукт, решающий актуальную проблему: поиск стильных, удобных и профессиональных workspace в крупных городах. Целевая аудитория — фрилансеры, стартапы, корпоративные клиенты и организаторы ивентов.",
  "author": {
    "name": "Surnyn Alexey",
    "email": "alxvagbar@gmail.com"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "concurrently vite",
    "dev:server": "json-server place.json",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prettier": "prettier --write src/**/*.ts",
    "lint": "eslint --debug src/",
    "lint:write": "eslint --debug src/ --fix"
  },
  "husky": {
    "hooks": {
      "pre-commit": "",
      "pre-push": ""
    }
  },
  "lint-staged": {
    "*.(ts|tsx)": [
      "npm run lint:write",
      "git add"
    ]
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.6.0",
    "axios": "^1.8.1",
    "json-server": "^1.0.0-beta.3",
    "json-server-auth": "^2.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.2.0",
    "sass-embedded": "^1.85.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-redux": "^7.1.34",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  }
}
